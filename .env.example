# Everything prefixed NEXT_PUBLIC_ ships to the browser. Never put secrets here.
# The browser calls /api/v1 on this origin; next.config.mjs proxies it to the Spring Boot API (it has no CORS).
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:8080
# Shown on the licence-blocked screen and licence page. Optional.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
# development | test | staging | production. A badge in the top bar shows it everywhere except production (and when empty).
NEXT_PUBLIC_APP_ENV=
# Sign out after this many minutes without activity (a 60-second countdown comes first). Empty or 0 turns it off.
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=
